//CMakeLists.txt
cmake_minimum_required(VERSION 3.0.2)
project(drone_bringup)

find_package(catkin REQUIRED COMPONENTS
  roscpp
  geometry_msgs
  std_msgs
)

catkin_package(
  CATKIN_DEPENDS roscpp geometry_msgs std_msgs
)

include_directories(${catkin_INCLUDE_DIRS})

add_executable(flight_node src/flight_node.cpp)
target_link_libraries(flight_node ${catkin_LIBRARIES})

//package.xml
<?xml version="1.0"?>
<package format="2">
  <name>drone_bringup</name>
  <version>0.1.0</version>
  <description>起飞与避障：新人筛选任务的工作包</description>

  <maintainer email="drone-team@example.com">drone team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>roscpp</build_depend>
  <build_depend>drone_backend</build_depend>

  <exec_depend>roscpp</exec_depend>
  <exec_depend>drone_backend</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
</package>

